# Discord
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=   # 업데이트 공지할 채널 ID

# Anthropic (LLM routing — decides GIF vs image)
ANTHROPIC_API_KEY=

# Giphy GIF Search (https://developers.giphy.com/)
GIPHY_API_KEY=

# Naver Image Search (https://developers.naver.com/docs/serviceapi/search/image/image.md)
# Used for image search — 25,000 req/day free
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional: override Claude model (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001
